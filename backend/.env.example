# Database
DATABASE_URL="postgresql://user:password@localhost:5432/4evrcustoms?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change-me-minimo-16-caracteres
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Cloudinary (Photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web Push (genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@4evrcustoms.mx

# Seed inicial (admin) - obligatoria la primera vez
SEED_ADMIN_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# OTP
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=3

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

